{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-memory",
  "main": "index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "traces": {"enabled": true},
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ALLOWED_USER_ID": "user_2WmGvirCeic7h9XFQznaJXB4gkr",
    "ALLOWED_HOSTS": "mcp-memory.thekevinwang.workers.dev,localhost,127.0.0.1",
    "MCP_RESOURCE_URL": "https://mcp-memory.thekevinwang.workers.dev/mcp",
    "CLERK_ISSUER": "https://clerk.thekevinwang.com",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudGhla2V2aW53YW5nLmNvbSQ",
  },
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY",
    ],
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vectorize": [
    {
      "binding": "MEMORIES",
      "index_name": "mcp-memory-qwen3",
      "remote": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "MEMORY_CATALOG",
      "database_name": "mcp-memory-catalog",
      "database_id": "e6627b59-3098-462c-8a85-d3d92c9fadeb",
      "migrations_dir": "migrations",
      "remote": true,
    },
  ],
}

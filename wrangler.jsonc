{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-memory",
  "main": "index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "traces": {"enabled": true},
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ALLOWED_HOSTS": ["mcp-memory.thekevinwang.workers.dev"],
    "MCP_RESOURCE_URL": "https://mcp-memory.thekevinwang.workers.dev/mcp",
    // Publishable Key is not sensitive
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudGhla2V2aW53YW5nLmNvbSQ",
  },
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY",
    ],
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vectorize": [
    {
      "binding": "MEMORIES",
      "index_name": "mcp-memory-qwen3",
      "remote": true,
    },
  ],
}
